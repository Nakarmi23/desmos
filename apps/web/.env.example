# Copy to `.env` and fill in. Next.js and `pnpm db:migrate` both read `.env`.
# In development and test every var below is optional: unset ones fall back to
# the defaults noted here. In production there are no defaults.

# --- Database (read at boot) -------------------------------------------------
# Dev defaults match docker-compose.yml; tests always use the desmos_test DB.
DB_HOST=localhost
DB_PORT=5432
DB_USER=desmos
DB_PASSWORD=desmos
DB_NAME=desmos

# --- Initial User (read only by the seed migration) ---------------------------
# Used once, when migrations first create the Initial User. Changing them later
# has no effect, and they can be removed after the first migration.
# Dev/test defaults: admin / local-dev-admin-password / Administrator / no email.
# The password must be at least 24 characters in every environment.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-24-plus-characters
INITIAL_ADMIN_NAME=Administrator
# Optional.
INITIAL_ADMIN_EMAIL=
